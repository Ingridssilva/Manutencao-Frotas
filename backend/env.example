# Copie este arquivo para ".env" e preencha com seus próprios valores.
# Nunca faça commit do arquivo ".env" real (ele já está no .gitignore).

FLASK_ENV=development

# --- Banco de dados (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/nome_do_banco

# --- Segurança ---
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
ADMIN_SENHA_INICIAL=

# --- URL pública da aplicação ---
BASE_URL=http://localhost:5000

# --- Autenticação Azure AD (Entra ID) ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:5000/auth/callback
# Lista de e-mails autorizados a logar (separados por vírgula). Se vazio, usa a lista padrão em settings.py.
AZURE_ALLOWED_EMAILS=

# --- SharePoint / Microsoft Graph API ---
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_PASTA_FROTA=

# --- Aprovação de OS/Orçamentos ---
OS_LIMITE_APROVACAO=1000

# --- WhatsApp (UltraMsg) para notificação de aprovação de alto valor ---
ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=
WHATSAPP_APROVADOR=

# --- E-mails de notificação ---
EMAIL_REMETENTE=ti@empresaexemplo.com.br
EMAIL_NOTIFICACAO_FALLBACK=owner@empresaexemplo.com.br
EMAIL_FINANCEIRO=financeiro@empresaexemplo.com.br
EMAIL_COPIA_TI=ti@empresaexemplo.com.br
EMAIL_CC_TI=ti@empresaexemplo.com.br
EMAILS_GESTORES_FIXOS=

# --- Alertas de vencimento (dias de antecedência) ---
ALERTA_DIAS_CRLV=60
ALERTA_DIAS_CNH=60
ALERTA_DIAS_LAUDO=30
ALERTA_DIAS_TACOGRAFO=30
ALERTA_DIAS_SEGURO=45

# --- Limite de upload (bytes) ---
MAX_CONTENT_LENGTH=20971520

# --- Geração de orçamento assistida por IA (opcional) ---
ANTHROPIC_API_KEY=
